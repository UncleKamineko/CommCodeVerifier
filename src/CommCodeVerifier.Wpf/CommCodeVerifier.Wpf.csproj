<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net8.0-windows</TargetFramework>
        <UseWPF>true</UseWPF>
        <AssemblyName>CommCodeVerifier</AssemblyName>
        <RootNamespace>CommCodeVerifier.Wpf</RootNamespace>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <!-- Только русские ресурсы .NET: меньше размер сборки с .NET внутри. -->
        <SatelliteResourceLanguages>ru</SatelliteResourceLanguages>
        <ApplicationIcon>Assets\Elegantthemes-Softies-Clipboard.ico</ApplicationIcon>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\CommCodeVerifier.Core\CommCodeVerifier.Core.csproj" />

    </ItemGroup>
    <!-- Справка: Assets\Help.rtf копируется рядом с exe при сборке и публикации.
       ExcludeFromSingleFile — файл лежит отдельно, его можно заменить без пересборки. -->
    <ItemGroup>
        <!-- Справка: копируется рядом с exe, не встраивается — можно заменить без пересборки. -->
        <None Include="Assets\Help.rtf"
              CopyToOutputDirectory="PreserveNewest"
              CopyToPublishDirectory="PreserveNewest"
              ExcludeFromSingleFile="true" />    </ItemGroup>
      
    <!-- Шаблонные файлы конфигурации: при сборке и публикации кладутся рядом с exe
       в «Файлы конфигурации». Не встраиваются в exe (ExcludeFromSingleFile). -->
    <ItemGroup>
        <None Include="Assets\Файлы конфигурации\**\*"
              Link="Файлы конфигурации\%(RecursiveDir)%(Filename)%(Extension)"
              CopyToOutputDirectory="PreserveNewest"
              CopyToPublishDirectory="PreserveNewest"
              ExcludeFromSingleFile="true" />
    </ItemGroup>
    
    <ItemGroup>
        <Resource Include="Assets\Elegantthemes-Softies-Clipboard.ico" />
    </ItemGroup>
    
    <ItemGroup>
      <Folder Include="Ресурсы\" />
    </ItemGroup>

</Project>