<UserControl x:Class="CommCodeVerifier.Wpf.Controls.NumericUpDown"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="24">
    <Border BorderBrush="{x:Static SystemColors.ControlDarkBrush}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="Box"
                     Grid.Column="0"
                     BorderThickness="0"
                     TextAlignment="Center"
                     VerticalContentAlignment="Center"
                     InputMethod.IsInputMethodEnabled="False" />

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <RepeatButton Grid.Row="0" Focusable="False" Padding="0"
                              Delay="400" Interval="80" Click="OnUp"
                              ToolTip="Больше">
                    <Path Data="M0,4 L4,0 L8,4 Z" Fill="{x:Static SystemColors.ControlTextBrush}" />
                </RepeatButton>
                <RepeatButton Grid.Row="1" Focusable="False" Padding="0"
                              Delay="400" Interval="80" Click="OnDown"
                              ToolTip="Меньше">
                    <Path Data="M0,0 L8,0 L4,4 Z" Fill="{x:Static SystemColors.ControlTextBrush}" />
                </RepeatButton>
            </Grid>
        </Grid>
    </Border>
</UserControl>
