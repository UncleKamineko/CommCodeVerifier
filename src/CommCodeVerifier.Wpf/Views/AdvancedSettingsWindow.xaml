<Window x:Class="CommCodeVerifier.Wpf.Views.AdvancedSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CommCodeVerifier.Wpf.Controls"
        xmlns:settings="clr-namespace:CommCodeVerifier.Wpf.Settings"
        xmlns:local="clr-namespace:CommCodeVerifier.Wpf.Views"
        Title="Расширенные настройки"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        FontSize="{x:Static local:ProgramSettingsWindow.TextFontSize}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- Постоянные шрифты и радиус кнопок, как в «Настройках программы»:
             окно остаётся читаемым при любых значениях, которые в нём задаются. -->
        <x:Static x:Key="Font.Text" Member="local:ProgramSettingsWindow.TextFontSize" />
        <x:Static x:Key="Font.Button" Member="local:ProgramSettingsWindow.ButtonFontSize" />
        <CornerRadius x:Key="Radius.Button">6</CornerRadius>

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="MaxWidth" Value="420" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,6,10,6" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="GroupHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,4,0,4" />
        </Style>
        <Style x:Key="DefaultHint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Hint}" />
            <Setter Property="Margin" Value="0,6,0,6" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="FontSizeBox" TargetType="controls:NumericUpDown">
            <Setter Property="Width" Value="80" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="0,3,10,3" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Minimum" Value="{x:Static settings:UiSettings.MinFont}" />
            <Setter Property="Maximum" Value="{x:Static settings:UiSettings.MaxFont}" />
        </Style>
        <Style x:Key="RadiusBox" TargetType="controls:NumericUpDown" BasedOn="{StaticResource FontSizeBox}">
            <Setter Property="Minimum" Value="{x:Static settings:AdvancedUiSettings.MinRadius}" />
            <Setter Property="Maximum" Value="{x:Static settings:AdvancedUiSettings.MaxRadius}" />
        </Style>
        <Style x:Key="FontBox" TargetType="ComboBox">
            <Setter Property="Width" Value="240" />
            <Setter Property="Margin" Value="0,3,10,3" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="ItemsSource" Value="{Binding FontFamilies}" />
            <!-- Список рисует каждое название своим шрифтом. -->
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontFamily="{Binding}" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <!-- Длинный список шрифтов: виртуализация, иначе открывается медленно. -->
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel>
        <!-- Столбцы общие со строками разделов (SharedSizeGroup), чтобы всё выровнялось. -->
        <Grid Margin="16,16,16,8" Grid.IsSharedSizeScope="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="Caption" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="Value" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="Hint" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <!-- 0 шрифт интерфейса -->
                <RowDefinition Height="Auto" />
                <!-- 1 разделитель -->
                <RowDefinition Height="Auto" />
                <!-- 2 заголовок группы «Заголовок окна» -->
                <RowDefinition Height="Auto" />
                <!-- 3 шрифт заголовка -->
                <RowDefinition Height="Auto" />
                <!-- 4 размер заголовка -->
                <RowDefinition Height="Auto" />
                <!-- 5 разделитель -->
                <RowDefinition Height="Auto" />
                <!-- 6 заголовок группы «Разделы» -->
                <RowDefinition Height="Auto" />
                <!-- 7 шрифты разделов (по строке на раздел) -->
                <RowDefinition Height="Auto" />
                <!-- 8 разделитель -->
                <RowDefinition Height="Auto" />
                <!-- 9 заголовок группы «Скругления» -->
                <RowDefinition Height="Auto" />
                <!-- 10 вкладки -->
                <RowDefinition Height="Auto" />
                <!-- 11 разделы -->
                <RowDefinition Height="Auto" />
                <!-- 12 кнопки -->
            </Grid.RowDefinitions>

            <!-- Шрифт интерфейса -->
            <TextBlock Grid.Row="0" Style="{StaticResource Caption}"
                       Text="Шрифт интерфейса главного окна" />
            <ComboBox Grid.Row="0" Grid.Column="1" Style="{StaticResource FontBox}"
                      SelectedItem="{Binding UiFontFamily}" />
            <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource DefaultHint}"
                       Text="{Binding Source={x:Static settings:AdvancedUiSettings.DefaultUiFontFamily}, StringFormat=по умолчанию {0}}" />

            <Separator Grid.Row="1" Grid.ColumnSpan="3" Margin="0,8" />

            <!-- Заголовок окна -->
            <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource GroupHeader}"
                       Text="Заголовок главного окна" />

            <TextBlock Grid.Row="3" Style="{StaticResource Caption}" Text="Шрифт" />
            <ComboBox Grid.Row="3" Grid.Column="1" Style="{StaticResource FontBox}"
                      SelectedItem="{Binding TitleFontFamily}" />
            <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource DefaultHint}"
                       Text="{Binding Source={x:Static settings:AdvancedUiSettings.DefaultTitleFontFamily}, StringFormat=по умолчанию {0}}" />

            <TextBlock Grid.Row="4" Style="{StaticResource Caption}" Text="Размер шрифта, px" />
            <controls:NumericUpDown Grid.Row="4" Grid.Column="1" Style="{StaticResource FontSizeBox}"
                                    Value="{Binding TitleFontPx}" />
            <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource DefaultHint}"
                       Text="{Binding Source={x:Static settings:AdvancedUiSettings.DefaultTitleFont}, StringFormat=по умолчанию {0}}" />

            <Separator Grid.Row="5" Grid.ColumnSpan="3" Margin="0,8" />

            <!-- Разделы: строки строятся по фактическим разделам навигации
                 (MainViewModel.Sections), значения по умолчанию — из их стилей в Styles.xaml. -->
            <TextBlock Grid.Row="6" Grid.ColumnSpan="3" Style="{StaticResource GroupHeader}"
                       Text="Названия разделов (левая колонка): шрифт, размер, px" />

            <ItemsControl Grid.Row="7" Grid.ColumnSpan="3"
                          ItemsSource="{Binding SectionFonts}"
                          Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Caption" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Value" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Hint" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Style="{StaticResource Caption}" Text="{Binding Title}" />

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <ComboBox Style="{StaticResource FontBox}"
                                          ItemsSource="{Binding DataContext.FontFamilies,
                                                        RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedItem="{Binding FontFamily}" />
                                <controls:NumericUpDown Style="{StaticResource FontSizeBox}"
                                                        Value="{Binding FontPx}" />
                                <CheckBox Margin="0,6,10,6"
                                          VerticalAlignment="Center"
                                          VerticalContentAlignment="Center"
                                          Content="Полужирный"
                                          IsChecked="{Binding Bold}" />
                            </StackPanel>

                            <TextBlock Grid.Column="2" Style="{StaticResource DefaultHint}"
                                       Text="{Binding DefaultText}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Separator Grid.Row="8" Grid.ColumnSpan="3" Margin="0,8" />

            <!-- Скругления -->
            <TextBlock Grid.Row="9" Grid.ColumnSpan="3" Style="{StaticResource GroupHeader}"
                       Text="Радиусы скругления углов, px" />

            <TextBlock Grid.Row="10" Style="{StaticResource Caption}" Text="Вкладки (верхние углы)" />
            <controls:NumericUpDown Grid.Row="10" Grid.Column="1" Style="{StaticResource RadiusBox}"
                                    Value="{Binding TabRadius}" />
            <TextBlock Grid.Row="10" Grid.Column="2" Style="{StaticResource DefaultHint}"
                       Text="{Binding Source={x:Static settings:AdvancedUiSettings.DefaultTabRadius}, StringFormat=по умолчанию {0}}" />

            <TextBlock Grid.Row="11" Style="{StaticResource Caption}" Text="Разделы (левые углы)" />
            <controls:NumericUpDown Grid.Row="11" Grid.Column="1" Style="{StaticResource RadiusBox}"
                                    Value="{Binding SectionRadius}" />
            <TextBlock Grid.Row="11" Grid.Column="2" Style="{StaticResource DefaultHint}"
                       Text="{Binding Source={x:Static settings:AdvancedUiSettings.DefaultSectionRadius}, StringFormat=по умолчанию {0}}" />

            <TextBlock Grid.Row="12" Style="{StaticResource Caption}" Text="Кнопки" />
            <controls:NumericUpDown Grid.Row="12" Grid.Column="1" Style="{StaticResource RadiusBox}"
                                    Value="{Binding ButtonRadius}" />
            <TextBlock Grid.Row="12" Grid.Column="2" Style="{StaticResource DefaultHint}"
                       Text="{Binding Source={x:Static settings:AdvancedUiSettings.DefaultButtonRadius}, StringFormat=по умолчанию {0}}" />
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,4,16,14">
            <StackPanel.Resources>
                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                    <Setter Property="MinWidth" Value="96" />
                    <Setter Property="MinHeight" Value="30" />
                    <Setter Property="Margin" Value="6,0,0,0" />
                </Style>
            </StackPanel.Resources>
            <Button Content="Значения по умолчанию" Command="{Binding ResetDefaultsCommand}" />
            <Button Content="Отмена" IsCancel="True" />
            <Button Content="Сохранить" IsDefault="True" Click="OnSave" />
        </StackPanel>
    </StackPanel>
</Window>
