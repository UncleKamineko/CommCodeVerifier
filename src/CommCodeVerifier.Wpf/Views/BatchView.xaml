<UserControl x:Class="CommCodeVerifier.Wpf.Views.BatchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CommCodeVerifier.Wpf.ViewModels">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- заголовок -->
            <RowDefinition Height="Auto" />
            <!-- описание -->
            <RowDefinition Height="Auto" />
            <!-- кнопки -->
            <RowDefinition Height="Auto" />
            <!-- ошибка -->
            <RowDefinition Height="Auto" />
            <!-- прогресс -->
            <RowDefinition Height="Auto" />
            <!-- дубликаты -->
            <RowDefinition Height="*" />
            <!-- сводка -->
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource HeaderText}"
                   Text="Групповая проверка коммерческих кодов" Margin="0,4,0,6" />

        <TextBlock Grid.Row="1" TextWrapping="Wrap" Margin="0,4,0,6">
            <Run Text="Загрузите файл Excel (.xlsx) для анализа, " />
            <Bold>
                <Run Text="файл должен иметь 3 столбца с заголовками &quot;Номенклатура.Артикул&quot;, &quot;Коммерческий код&quot; и &quot;Номенклатура.Группа выгрузки ИМ (Общие)&quot;" />
            </Bold>
        </TextBlock>

        <WrapPanel Grid.Row="2" Margin="0,4,0,6">
            <WrapPanel.Resources>
                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                    <Setter Property="Margin" Value="0,0,8,4" />
                </Style>
            </WrapPanel.Resources>
            <Button Content="Загрузить файл для анализа"
                    Command="{Binding LoadAndRunCommand}" />
            <Button Content="Прервать анализ"
                    Command="{Binding CancelCommand}"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            <Button Content="Открыть папку с результатами анализа"
                    Command="{Binding OpenFolderCommand}"
                    Visibility="{Binding CanOpenFolder, Converter={StaticResource BoolToVis}}"
                    FontWeight="Bold"
                    Margin="4,0,8,4"
                    Background="{DynamicResource Brush.Button.Accent}" />
            <TextBlock Text="{x:Static vm:BatchViewModel.NoInvalidCodesText}"
                       Visibility="{Binding NoInvalidCodes, Converter={StaticResource BoolToVis}}"
                       Foreground="#FF029802"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="0,0,8,4"
                       FontSize="18" />
        </WrapPanel>

        <TextBlock Grid.Row="3" Text="{Binding Error}"
                   Foreground="Red" TextWrapping="Wrap" Margin="0,4,0,6"
                   Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,4,0,6">
            <ProgressBar Width="500" Height="20"
                         Minimum="0" Maximum="100"
                         Value="{Binding Progress, Mode=OneWay}"
                         IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}" />
            <TextBlock Text="{Binding Status}" Margin="10,0,0,0" VerticalAlignment="Center"
                       TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Hint}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusSuccess}" Value="True">
                                <Setter Property="Foreground" Value="DarkGreen" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <TextBlock Grid.Row="5" Style="{StaticResource WarningText}"
                   Foreground="Red"
                   Text="{Binding DuplicateWarning}" Margin="0,4,0,6"
                   Visibility="{Binding HasDuplicateWarning, Converter={StaticResource BoolToVis}}" />

        <!-- Сводка: правило — слева, счётчик — по правому краю. -->
        <Grid Grid.Row="6" Margin="0,4,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border BorderBrush="{x:Static SystemColors.ControlDarkBrush}" BorderThickness="1"
                    Background="White">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Summary}" Margin="6,4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Style="{StaticResource SummaryText}"
                                               Text="{Binding Left}" TextWrapping="Wrap" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource SummaryText}"
                                               Text="{Binding Right}" Margin="16,0,0,0"
                                               HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <Button Grid.Row="1" Content="Копировать сводку"
                    Command="{Binding CopySummaryCommand}"
                    HorizontalAlignment="Left" Margin="0,6,0,0"
                    Visibility="{Binding Summary.Count, Converter={StaticResource CountToVis}}" />
        </Grid>
    </Grid>
</UserControl>
