<UserControl x:Class="CommCodeVerifier.Wpf.Views.CylinderArticleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CommCodeVerifier.Wpf.Controls">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="14">
            <TextBlock Style="{StaticResource HeaderText}"
                       Text="Генерация артикула цилиндра"
                       Margin="0,4,0,10"
                       FontSize="16"/>

            <GroupBox Padding="12"
                      BorderBrush="Black"
                      BorderThickness="3">
                <GroupBox.Header>
                    <TextBlock Text="Коммерческий код"
                               FontWeight="Bold" />
                </GroupBox.Header>

                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBox Text="{Binding CommercialCode,
                                                 UpdateSourceTrigger=PropertyChanged}"
                                 MinHeight="30"
                                 VerticalContentAlignment="Center">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter"
                                            Command="{Binding GenerateCommand}" />
                            </TextBox.InputBindings>
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Style.Triggers>
                                        <!-- Пока поверх поля показан код с подсветкой замен,
                                             собственный текст поля скрыт. -->
                                        <DataTrigger Binding="{Binding CyrillicReplaced}"
                                                     Value="True">
                                            <Setter Property="Foreground"
                                                    Value="Transparent" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <controls:HighlightedTextBlock Segments="{Binding ReplacedCodeHighlight}"
                                                       Visibility="{Binding CyrillicReplaced,
                                                                    Converter={StaticResource BoolToVis}}"
                                                       IsHitTestVisible="False"
                                                       VerticalAlignment="Center"
                                                       Margin="4,0,4,0" />
                    </Grid>

                    <TextBlock Style="{StaticResource WarningText}"
                               Text="Введённый код содержал кириллицу, она заменена на латиницу. В поле ввода ИСПРАВЛЕННЫЙ код!"
                               Visibility="{Binding CyrillicReplaced,
                                            Converter={StaticResource BoolToVis}}"
                               Margin="0,0,0,8" />

                    <TextBlock Text="Символы спец.исполнения в конце артикула:"
                               Margin="0,0,0,4" />

                    <TextBox Text="{Binding ManualAdditionalCode,
                                             UpdateSourceTrigger=PropertyChanged}"
                             MinHeight="28"
                             Margin="0,0,0,8" />

                    <Button Content="Сформировать артикул"
                            Command="{Binding GenerateCommand}"
                            HorizontalAlignment="Left"
                            Padding="14,5" Background="{DynamicResource Brush.Button.Accent}" FontWeight="Bold" />

                    <TextBlock Text="Артикул"
                               FontWeight="SemiBold"
                               Margin="0,14,0,4" />

                    <TextBox Text="{Binding Article}"
                             IsReadOnly="True"
                             FontSize="18"
                             FontWeight="Bold">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Foreground"
                                        Value="Black" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TailTooLong}"
                                                 Value="True">
                                        <Setter Property="Foreground"
                                                Value="Red" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <TextBlock Text="{Binding Message}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0" />
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
