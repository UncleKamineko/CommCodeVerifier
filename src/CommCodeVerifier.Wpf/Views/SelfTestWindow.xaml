<Window x:Class="CommCodeVerifier.Wpf.Views.SelfTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Автотест правил"
        Width="780" Height="580"
        MinWidth="480" MinHeight="300"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        FontSize="{DynamicResource Font.Text}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <DockPanel>
        <TextBlock x:Name="HeaderText" DockPanel.Dock="Top"
                   FontSize="{DynamicResource Font.Header}" FontWeight="Bold"
                   Margin="12,10,12,6" />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="12,8,12,12">
            <Button Content="Копировать" Click="OnCopy" MinWidth="96" Margin="0,0,8,0" />
            <Button Content="Закрыть" IsCancel="True" IsDefault="True" MinWidth="96" />
        </StackPanel>

        <TextBox x:Name="ReportBox"
                 IsReadOnly="True"
                 FontFamily="Consolas"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 Margin="12,0" />
    </DockPanel>
</Window>
