<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Значки кнопок: векторные, система координат 24×24.
         Цвет — Foreground кнопки (меняется вместе с ней, затемняется при IsEnabled=False).
         x:Shared="False" — у каждой кнопки свой экземпляр значка. -->

    <!-- Справка: окружность и знак вопроса. -->
    <Viewbox x:Key="Icon.Help" x:Shared="False" Width="18" Height="18">
        <Canvas Width="24" Height="24">
            <Path StrokeThickness="3"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                <Path.Data>
                    <EllipseGeometry Center="12,12" RadiusX="12" RadiusY="12" />
                </Path.Data>
            </Path>
            <!-- Крючок вопроса: дуга 270° с центром (12; 9,5) и короткая ножка. -->
            <Path Data="M9.5,9.5 A2.5,2.5 0 1 1 12,12 L12,13.6"
                  StrokeThickness="3"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                <Path.Data>
                    <EllipseGeometry Center="12,16.9" RadiusX="1.2" RadiusY="1.2" />
                </Path.Data>
            </Path>
        </Canvas>
    </Viewbox>

    <!-- Настройки: шестерёнка — кольцо (радиусы 4…7) и 8 зубцов (до радиуса 10). -->
    <Viewbox x:Key="Icon.Settings" x:Shared="False" Width="18" Height="18">
        <Canvas Width="24" Height="24">
            <Path StrokeThickness="3"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                <Path.Data>
                    <EllipseGeometry Center="12,12" RadiusX="5.5" RadiusY="5.5" />
                </Path.Data>
            </Path>
            <Path StrokeThickness="3.2"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  Data="M12,2 L12,5.5   M12,18.5 L12,22
                        M2,12 L5.5,12   M18.5,12 L22,12
                        M4.93,4.93 L7.4,7.4     M16.6,16.6 L19.07,19.07
                        M19.07,4.93 L16.6,7.4   M7.4,16.6 L4.93,19.07" />
        </Canvas>
    </Viewbox>
</ResourceDictionary>
