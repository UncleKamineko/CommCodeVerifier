<Window x:Class="CommCodeVerifier.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CommCodeVerifier.Wpf.Views"
        Title="CommCodeVerifier v1.0.0"
        Width="1000" Height="740"
        MinWidth="800" MinHeight="500"
        Background="{DynamicResource Brush.Window.Background}"
        Icon="pack://application:,,,/Elegantthemes-Softies-Clipboard.ico"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        FontSize="{DynamicResource Font.Text}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <!-- Свой заголовок: Windows по-прежнему отвечает за перетаскивание, Snap, тень и рамку. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0,0,0,1"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Key="F1" Command="{Binding OpenHelpCommand}" />
        <KeyBinding Key="T" Modifiers="Ctrl+Shift" Command="{Binding RunSelfTestCommand}" />
    </Window.InputBindings>

    <!-- В развёрнутом виде Windows выносит края окна за экран — компенсируем отступом. -->
    <Border x:Name="RootBorder">
        <DockPanel>
            <!-- ================= заголовок ================= -->
            <Grid DockPanel.Dock="Top" Height="32" Background="{DynamicResource Brush.TitleBar}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Значок: щелчок открывает системное меню (как в обычном окне). -->
                <Image Grid.Column="0" Width="16" Height="16" Margin="10,0,8,0"
                       Source="{Binding Icon, RelativeSource={RelativeSource AncestorType=Window}}"
                       WindowChrome.IsHitTestVisibleInChrome="True"
                       MouseLeftButtonDown="OnIconClick" />

                <TextBlock x:Name="TitleText" Grid.Column="1"
                           Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                           FontFamily="{DynamicResource FontFamily.Title}"
                           FontSize="{DynamicResource Font.Title}"
                           Foreground="{DynamicResource Brush.TitleText}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;"
                            ToolTip="Свернуть" Click="OnMinimize" />
                    <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;"
                            ToolTip="Развернуть" Click="OnMaximizeRestore" />
                    <Button Style="{StaticResource CaptionCloseButton}" Content="&#xE8BB;"
                            ToolTip="Закрыть" Click="OnClose" />
                </StackPanel>
            </Grid>

            <!-- ================= содержимое окна (прежний Grid без изменений) ================= -->
            <Grid Margin="6">
                <TabControl Style="{StaticResource MainTabControl}"
                    SelectedIndex="{Binding SelectedTabIndex}" SelectionChanged="TabControl_SelectionChanged">
                    <TabItem Header="Один код" Margin="0,0,0,-1" HorizontalAlignment="Center" Width="Auto">
                        <views:SingleCheckView DataContext="{Binding SingleCheck}" />
                    </TabItem>
                    <TabItem Header="Групповая проверка" Margin="0,0,0,-1" HorizontalAlignment="Left" Width="Auto">
                        <views:BatchView DataContext="{Binding Batch}" />
                    </TabItem>
                    <TabItem Header="Настройки анализа" Margin="0,0,0,-1" HorizontalAlignment="Center">
                        <views:AnalysisSettingsView DataContext="{Binding AnalysisSettings}" />
                    </TabItem>
                    <!-- Увеличенный зазор перед вкладкой ИМ — как в WinForms. -->
                    <TabItem Header="Проверка для ИМ" Style="{StaticResource MainTabItemWideGap}" Margin="53,0,-53,-1">
                        <views:ImCheckView DataContext="{Binding ImCheck}" Loaded="ImCheckView_Loaded" />
                    </TabItem>
                </TabControl>
                <Grid HorizontalAlignment="Right" VerticalAlignment="Top" Width="76">
                    <Button x:Name="HelpButton"
                        Style="{StaticResource IconButton}"
                        Content="{StaticResource Icon.Help}"
                        ToolTip="Справка по программе"
                        AutomationProperties.Name="Справка по программе"
                        Command="{Binding OpenHelpCommand}"
                        Margin="42,0,0,0" Click="HelpButton_Click_1" Width="34" Height="30" VerticalAlignment="Center" HorizontalAlignment="Left" />
                    <Button x:Name="PrefsButton"
                        Style="{StaticResource IconButton}"
                        Content="{StaticResource Icon.Settings}"
                        ToolTip="Настройки программы"
                        AutomationProperties.Name="Настройки программы"
                        Command="{Binding OpenProgramSettingsCommand}" Click="PrefsButton_Click" Height="30" VerticalAlignment="Center" HorizontalAlignment="Left" Width="32" />

                </Grid>

            </Grid>
        </DockPanel>
    </Border>
</Window>
