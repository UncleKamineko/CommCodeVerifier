<UserControl x:Class="CommCodeArticle.Views.CylinderArticleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="14">
            <TextBlock Style="{StaticResource HeaderText}"
                       Text="Генерация артикула цилиндра"
                       Margin="0,4,0,10"
                       FontSize="16"/>

            <GroupBox Padding="12"
                      BorderBrush="Black"
                      BorderThickness="3">
                <GroupBox.Header>
                    <TextBlock Text="Коммерческий код"
                               FontWeight="Bold" />
                </GroupBox.Header>

                <StackPanel>
                    <TextBox Text="{Binding CommercialCode,
                                             UpdateSourceTrigger=PropertyChanged}"
                             MinHeight="30"
                             Margin="0,0,0,8" />

                    <TextBlock Text="Символы спец.исполнения в конце артикула:"
                               Margin="0,0,0,4" />

                    <TextBox Text="{Binding ManualAdditionalCode,
                                             UpdateSourceTrigger=PropertyChanged}"
                             MinHeight="28"
                             Margin="0,0,0,8" />

                    <Button Content="Сформировать артикул"
                            Command="{Binding GenerateCommand}"
                            HorizontalAlignment="Left"
                            Padding="14,5" Background="{DynamicResource Brush.Button.Accent}" FontWeight="Bold" />

                    <TextBlock Text="Артикул"
                               FontWeight="SemiBold"
                               Margin="0,14,0,4" />

                    <TextBox Text="{Binding Article}"
                             IsReadOnly="True"
                             FontSize="18"
                             FontWeight="Bold">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Foreground"
                                        Value="Black" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TailTooLong}"
                                                 Value="True">
                                        <Setter Property="Foreground"
                                                Value="Red" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <TextBlock Text="{Binding Message}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0" />
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
