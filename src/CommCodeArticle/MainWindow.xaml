<Window x:Class="CommCodeArticle.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CommCodeArticle.Views"
        Title="CommCodeArticle v1.0.0"
        Width="720"
        Height="560"
        MinWidth="520"
        MinHeight="400"
        Background="{DynamicResource Brush.Window.Background}"
        Icon="pack://application:,,,/Elegantthemes-Softies-Clipboard.ico"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        FontSize="{DynamicResource Font.Text}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <views:CylinderArticleView />
</Window>
